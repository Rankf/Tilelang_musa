# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def kernel(A: T.handle, B: T.handle, out_handle: T.handle):
        T.func_attr({"target": T.target({"arch": "mp_31", "host": {"keys": ["cpu"], "kind": "c", "tag": ""}, "keys": ["musa", "gpu"], "kind": "musa", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "tilelang_out_idx": [-1]})
        A_1 = T.match_buffer(A, (128, 64), "float16", strides=(64, 1))
        B_1 = T.match_buffer(B, (128, 64), "float16", strides=(64, 1))
        out = T.match_buffer(out_handle, (128,), strides=(1,))
        with T.sblock("root"):
            T.reads()
            T.writes()
            acc = T.Buffer((128, 128), scope="local.fragment")
            a_shared = T.Buffer((128, 64), "float16", scope="shared.dyn")
            b_shared = T.Buffer((128, 64), "float16", scope="shared.dyn")
            out_local = T.Buffer((128,), scope="local.fragment")
            T.sblock_attr({"k_major_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(True)}, "layout_map": {acc: metadata["tl.Fragment"][0], a_shared: metadata["tl.Layout"][0], b_shared: metadata["tl.Layout"][1], out_local: metadata["tl.Fragment"][1]}, "sqmma_inst_split_map": {}, "sqmma_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(True)}})
            bx = T.launch_thread("blockIdx.x", 1)
            tx = T.launch_thread("threadIdx.x", 256)
            ty = T.launch_thread("threadIdx.y", 1)
            tz = T.launch_thread("threadIdx.z", 1)
            with T.sblock("tilelang_root"):
                T.reads()
                T.writes()
                T.sblock_attr({"k_major_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(True)}, "layout_map": {acc: metadata["tl.Fragment"][0], a_shared: metadata["tl.Layout"][0], b_shared: metadata["tl.Layout"][1], out_local: metadata["tl.Fragment"][1]}, "sqmma_inst_split_map": {}, "sqmma_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(True)}})
                a_shared = T.sblock_alloc_buffer((128, 64), "float16", data=a_shared.data, scope="shared.dyn")
                b_shared = T.sblock_alloc_buffer((128, 64), "float16", data=b_shared.data, scope="shared.dyn")
                acc = T.sblock_alloc_buffer((128, 128), data=acc.data, scope="local.fragment")
                out_local = T.sblock_alloc_buffer((128,), data=out_local.data, scope="local.fragment")
                T.fill(T.region(acc[0, 0], 2, 128, 128), 0, tl_provenance_ordinal=0)
                T.copy(T.region(A_1[0, 0], 1, 128, 64), T.region(a_shared[0, 0], 2, 128, 64), eviction_policy=0, inner_cache_policy=2, outer_cache_policy=2, tl_provenance_ordinal=1)
                T.copy(T.region(B_1[0, 0], 1, 128, 64), T.region(b_shared[0, 0], 2, 128, 64), eviction_policy=0, inner_cache_policy=2, outer_cache_policy=2, tl_provenance_ordinal=2)
                T.gemm(T.region(a_shared[0, 0], 1, 128, 64), T.region(b_shared[0, 0], 1, 128, 64), T.region(acc[0, 0], 3, 128, 128), T.bool(False), T.bool(True), 128, 128, 64, 0, T.bool(False), 64, 64, 0, 0, 1, 0, 0, 0, 0, tl_provenance_ordinal=3)
                T.reduce(T.region(acc[0, 0], 1, 128, 128), T.region(out_local[0], 2, 128), "sum", 1, T.bool(True), tl_provenance_ordinal=4)
                T.copy(T.region(out_local[0], 1, 128), T.region(out[0], 2, 128), eviction_policy=0, inner_cache_policy=2, outer_cache_policy=2, tl_provenance_ordinal=5)

