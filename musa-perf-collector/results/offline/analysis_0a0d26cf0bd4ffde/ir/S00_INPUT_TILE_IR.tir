# from tvm.script import tirx as T

@T.prim_func
def kernel(A: T.handle, B: T.handle, out_handle: T.handle):
    T.func_attr({"tilelang_out_idx": [-1]})
    A_1 = T.match_buffer(A, (128, 64), "float16", strides=(64, 1))
    B_1 = T.match_buffer(B, (128, 64), "float16", strides=(64, 1))
    out = T.match_buffer(out_handle, (128,), strides=(1,))
    # with T.sblock("root"):
    bx = T.launch_thread("blockIdx.x", 1)
    tx = T.launch_thread("threadIdx.x", 256)
    ty = T.launch_thread("threadIdx.y", 1)
    tz = T.launch_thread("threadIdx.z", 1)
    with T.sblock("tilelang_root"):
        T.reads()
        T.writes()
        a_shared = T.sblock_alloc_buffer((128, 64), "float16", scope="shared.dyn")
        b_shared = T.sblock_alloc_buffer((128, 64), "float16", scope="shared.dyn")
        acc = T.sblock_alloc_buffer((128, 128), scope="local.fragment")
        out_local = T.sblock_alloc_buffer((128,), scope="local.fragment")
        T.fill(T.region(acc[0, 0], 2, 128, 128), 0)
        T.copy(T.region(A_1[0, 0], 1, 128, 64), T.region(a_shared[0, 0], 2, 128, 64), eviction_policy=0, inner_cache_policy=2, outer_cache_policy=2)
        T.copy(T.region(B_1[0, 0], 1, 128, 64), T.region(b_shared[0, 0], 2, 128, 64), eviction_policy=0, inner_cache_policy=2, outer_cache_policy=2)
        T.gemm(T.region(a_shared[0, 0], 1, 128, 64), T.region(b_shared[0, 0], 1, 128, 64), T.region(acc[0, 0], 3, 128, 128), T.bool(False), T.bool(True), 128, 128, 64, 0, T.bool(False), 64, 64, 0, 0, 1, 0, 0, 0, 0)
        T.reduce(T.region(acc[0, 0], 1, 128, 128), T.region(out_local[0], 2, 128), "sum", 1, T.bool(True))
        T.copy(T.region(out_local[0], 1, 128), T.region(out[0], 2, 128), eviction_policy=0, inner_cache_policy=2, outer_cache_policy=2)