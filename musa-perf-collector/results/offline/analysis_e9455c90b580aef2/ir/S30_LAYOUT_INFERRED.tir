# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def kernel(A: T.handle, B: T.handle, offset: T.handle, C_handle: T.handle):
        T.func_attr({"target": T.target({"arch": "mp_31", "host": {"keys": ["cpu"], "kind": "c", "tag": ""}, "keys": ["musa", "gpu"], "kind": "musa", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "tilelang_out_idx": [-1], "tl_tiled_ws_applied": 1})
        A_1 = T.match_buffer(A, (128, 128), "float16", strides=(128, 1))
        B_1 = T.match_buffer(B, (128, 128), "float16", strides=(128, 1))
        offset_1 = T.match_buffer(offset, (1,), "int32", strides=(1,))
        C = T.match_buffer(C_handle, (128, 128), "float16", strides=(128, 1))
        with T.sblock("root"):
            T.reads()
            T.writes()
            acc = T.Buffer((64, 64), scope="local.fragment")
            a_shared = T.Buffer((2, 64, 32), "float16", scope="shared.dyn")
            b_shared = T.Buffer((2, 32, 64), "float16", scope="shared.dyn")
            T.sblock_attr({"k_major_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(False)}, "layout_map": {acc: metadata["tl.Fragment"][0], a_shared: metadata["tl.Layout"][0], b_shared: metadata["tl.Layout"][1]}, "sqmma_inst_split_map": {metadata["tl.Layout"][1]: 32}, "sqmma_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(True)}})
            bx = T.launch_thread("blockIdx.x", 2)
            by = T.launch_thread("blockIdx.y", 2)
            tx = T.launch_thread("threadIdx.x", 384)
            ty = T.launch_thread("threadIdx.y", 1)
            tz = T.launch_thread("threadIdx.z", 1)
            with T.sblock("tilelang_root"):
                T.reads()
                T.writes()
                mbarrier = T.handle("uint64", "shared.barrier")
                T.sblock_attr({"barrier_init": {mbarrier: [1, 1, 256, 256]}, "k_major_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(False)}, "layout_map": {acc: metadata["tl.Fragment"][0], a_shared: metadata["tl.Layout"][0], b_shared: metadata["tl.Layout"][1]}, "sqmma_inst_split_map": {metadata["tl.Layout"][1]: 32}, "sqmma_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(True)}})
                a_shared = T.sblock_alloc_buffer((2, 64, 32), "float16", data=a_shared.data, scope="shared.dyn")
                b_shared = T.sblock_alloc_buffer((2, 32, 64), "float16", data=b_shared.data, scope="shared.dyn")
                acc = T.sblock_alloc_buffer((64, 64), data=acc.data, scope="local.fragment")
                offset_local = T.sblock_alloc_buffer((1,), "int32", scope="local")
                offset_local_producer_ws = T.sblock_alloc_buffer((1,), "int32", scope="local")
                mbarrier_1 = T.sblock_alloc_buffer((4,), "uint64", data=mbarrier, scope="shared.barrier")
                T.attr([128, 256], "kWarpSpecializationScope", 0)
                if 256 <= tx:
                    T.copy(T.region(offset_1[0], 1, 1), T.region(offset_local_producer_ws[0], 2, 1), eviction_policy=0, inner_cache_policy=2, outer_cache_policy=2, tl_provenance_ordinal=0)
                    for kk in T.serial(4, annotations={"tl_provenance_loop_ordinal": 0}):
                        T.mbarrier_wait_parity(mbarrier_1[kk % 2 + 2], T.bitwise_xor(kk // 2, 1))
                        T.tma_copy(T.region(A_1[by * 64 + offset_local_producer_ws[0] * 64, kk * 32], 1, 64, 32), T.region(a_shared[kk % 2, 0, 0], 2, 1, 64, 32), eviction_policy=0, inner_cache_policy=2, outer_cache_policy=2, tl_provenance_ordinal=2, barrier=mbarrier_1[kk % 2], is_tma_copy=1, tl.pipeline_mbar_phase_expr=kk // 2)
                        T.tma_copy(T.region(B_1[kk * 32, bx * 64], 1, 32, 64), T.region(b_shared[kk % 2, 0, 0], 2, 1, 32, 64), eviction_policy=0, inner_cache_policy=2, outer_cache_policy=2, tl_provenance_ordinal=3, barrier=mbarrier_1[kk % 2], is_tma_copy=1, emit_arrive=1, tl.pipeline_mbar_phase_expr=kk // 2)
                else:
                    T.copy(T.region(offset_1[0], 1, 1), T.region(offset_local[0], 2, 1), eviction_policy=0, inner_cache_policy=2, outer_cache_policy=2, tl_provenance_ordinal=0)
                    T.fill(T.region(acc[0, 0], 2, 64, 64), 0, tl_provenance_ordinal=1)
                    for kk in T.serial(4, annotations={"tl_provenance_loop_ordinal": 0}):
                        T.mbarrier_wait_parity(mbarrier_1[kk % 2], kk // 2)
                        T.gemm(T.region(a_shared[kk % 2, 0, 0], 1, 1, 64, 32), T.region(b_shared[kk % 2, 0, 0], 1, 1, 32, 64), T.region(acc[0, 0], 3, 64, 64), T.bool(False), T.bool(False), 64, 64, 32, 0, T.bool(False), 32, 64, 0, 0, 1, 0, 0, 0, 0, tl_provenance_ordinal=4, tl.pipeline_mbar_phase_expr=kk // 2)
                        T.ptx_arrive_barrier(mbarrier_1[kk % 2 + 2])
                    T.copy(T.region(acc[0, 0], 1, 64, 64), T.region(C[by * 64 + offset_local[0] * 64, bx * 64], 2, 64, 64), eviction_policy=0, inner_cache_policy=2, outer_cache_policy=2, tl_provenance_ordinal=5)

