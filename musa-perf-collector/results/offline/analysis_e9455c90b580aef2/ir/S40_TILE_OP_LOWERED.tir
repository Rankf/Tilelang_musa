# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def kernel(A: T.handle, B: T.handle, offset: T.handle, C_handle: T.handle):
        T.func_attr({"target": T.target({"arch": "mp_31", "host": {"keys": ["cpu"], "kind": "c", "tag": ""}, "keys": ["musa", "gpu"], "kind": "musa", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "tilelang_out_idx": [-1], "tl.has_tma": T.bool(True), "tl_tiled_ws_applied": 1})
        A_1 = T.match_buffer(A, (128, 128), "float16", strides=(128, 1))
        B_1 = T.match_buffer(B, (128, 128), "float16", strides=(128, 1))
        offset_1 = T.match_buffer(offset, (1,), "int32", strides=(1,))
        C = T.match_buffer(C_handle, (128, 128), "float16", strides=(128, 1))
        with T.sblock("root"):
            T.reads()
            T.writes()
            a_shared = T.Buffer((2, 64, 32), "float16", scope="shared.dyn")
            b_shared = T.Buffer((2, 32, 64), "float16", scope="shared.dyn")
            acc = T.Buffer((16,), scope="local")
            T.sblock_attr({"k_major_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(False)}, "layout_map": {a_shared: metadata["tl.Layout"][0], b_shared: metadata["tl.Layout"][1], acc: metadata["tl.Fragment"][0]}, "sqmma_inst_split_map": {metadata["tl.Layout"][1]: 32}, "sqmma_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(True)}})
            bx = T.launch_thread("blockIdx.x", 2)
            by = T.launch_thread("blockIdx.y", 2)
            tx = T.launch_thread("threadIdx.x", 384)
            ty = T.launch_thread("threadIdx.y", 1)
            tz = T.launch_thread("threadIdx.z", 1)
            with T.sblock("tilelang_root"):
                T.reads()
                T.writes()
                mbarrier = T.handle("uint64", "shared.barrier")
                T.sblock_attr({"barrier_init": {mbarrier: [1, 1, 256, 256]}, "k_major_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(False)}, "layout_map": {a_shared: metadata["tl.Layout"][0], b_shared: metadata["tl.Layout"][1], acc: metadata["tl.Fragment"][0]}, "sqmma_inst_split_map": {metadata["tl.Layout"][1]: 32}, "sqmma_map": {metadata["tl.Layout"][0]: T.bool(True), metadata["tl.Layout"][1]: T.bool(True)}})
                a_shared = T.sblock_alloc_buffer((2, 64, 32), "float16", data=a_shared.data, scope="shared.dyn")
                b_shared = T.sblock_alloc_buffer((2, 32, 64), "float16", data=b_shared.data, scope="shared.dyn")
                acc = T.sblock_alloc_buffer((16,), data=acc.data, scope="local")
                offset_local = T.sblock_alloc_buffer((1,), "int32", scope="local")
                offset_local_producer_ws = T.sblock_alloc_buffer((1,), "int32", scope="local")
                mbarrier_1 = T.sblock_alloc_buffer((4,), "uint64", data=mbarrier, scope="shared.barrier")
                T.attr([128, 256], "kWarpSpecializationScope", 0)
                if 256 <= tx:
                    with T.attr(0, "tl.provenance_ordinal", 0):
                        for i in range(1):
                            offset_local_producer_ws[0] = offset_1[0]
                    for kk in T.serial(4, annotations={"tl_provenance_loop_ordinal": 0}):
                        T.mbarrier_wait_parity(mbarrier_1[kk % 2 + 2], T.bitwise_xor(kk // 2, 1))
                        with T.attr(0, "tl.provenance_ordinal", 2):
                            if T.tl_shuffle_elect(128):
                                T.mbarrier_expect_tx(mbarrier_1[kk % 2], 4096)
                                T.tma_load(T.create_tma_descriptor(4, 2, A_1.data, T.uint64(128), T.uint64(128), T.uint64(2), T.uint64(256), 32, 64, 1, 1, 0, 1, 2, 0), mbarrier_1[kk % 2], T.tvm_access_ptr(T.type_annotation("float16"), a_shared.data, kk % 2 * 2048, 2048, 2), kk * 32, by * 64 + offset_local_producer_ws[0] * 64, 0, 2, 2)
                        T.attr(0, "tl.provenance_ordinal", 3)
                        if T.tl_shuffle_elect(128):
                            T.mbarrier_expect_tx(mbarrier_1[kk % 2], 4096)
                            for s in T.unroll(2):
                                T.tma_load(T.create_tma_descriptor(4, 2, B_1.data, T.uint64(128), T.uint64(128), T.uint64(2), T.uint64(256), 32, 32, 1, 1, 0, 2, 2, 0), mbarrier_1[kk % 2], T.tvm_access_ptr(T.type_annotation("float16"), b_shared.data, kk % 2 * 2048 + 1024 * s, 1024, 2), bx * 64 + 32 * s, kk * 32, 0, 2, 2)
                            T.ptx_arrive_barrier(mbarrier_1[kk % 2])
                else:
                    with T.attr(0, "tl.provenance_ordinal", 0):
                        for i in range(1):
                            offset_local[0] = offset_1[0]
                    with T.attr(0, "tl.provenance_ordinal", 1):
                        if tx < 256 and tx >= 0:
                            for i in T.unroll(4, annotations={"pragma_unroll_explicit": T.bool(False)}):
                                for vec in T.vectorized(4):
                                    acc[((i * 4 + vec) // 4 * 16 + tx % 128 // 8) // 16 * 4 + (tx // 128 * 32 + (i * 4 + vec) % 4 * 8 + tx % 8) % 32 // 8] = T.Cast("float32", 0)
                    for kk in T.serial(4, annotations={"tl_provenance_loop_ordinal": 0}):
                        T.mbarrier_wait_parity(mbarrier_1[kk % 2], kk // 2)
                        with T.attr(0, "tl.provenance_ordinal", 4):
                            with T.sblock("_gemm_sqmma"):
                                T.reads()
                                T.writes()
                                T.sblock_attr({"lexical_alloc_scope": 1})
                                T.tl_gemm("tl::gemm_ss<64, 64, 32, 4, 2, 0, 0, 0, 32, 64, 0, 0, true, 64, 32, 32>", T.access_ptr(a_shared[kk % 2, (T.Mul(0, 64) + T.Mul(0, 2)) // 256 * 4 + (T.bitwise_xor(T.FloorMod(0, 4) * 4 + T.FloorDiv(0, 8), (T.Mul(0, 64) + T.Mul(0, 2)) // 256) * 16 + T.FloorMod(0, 8) * 2) // 64, T.bitwise_xor(T.FloorMod(0, 4) * 4 + T.FloorDiv(0, 8), (T.Mul(0, 64) + T.Mul(0, 2)) // 256) % 4 * 8 + T.FloorMod(0, 8)], 2048, 1), T.access_ptr(b_shared[kk % 2, T.FloorDiv(0, 32) * 16 + (T.Mul(0, 64) + T.FloorMod(0, 32) * 2) // 256 * 2 + (T.bitwise_xor(T.FloorMod(0, 4) * 2 + T.FloorMod(0, 32) // 16, (T.Mul(0, 64) + T.FloorMod(0, 32) * 2) // 256) * 32 + T.FloorMod(0, 16) * 2) // 128, (T.bitwise_xor(T.FloorMod(0, 4) * 2 + T.FloorMod(0, 32) // 16, (T.Mul(0, 64) + T.FloorMod(0, 32) * 2) // 256) % 4 * 32 + T.FloorMod(0, 16) * 2) // 64 * 32 + T.bitwise_xor(T.FloorMod(0, 4) * 2 + T.FloorMod(0, 32) // 16, (T.Mul(0, 64) + T.FloorMod(0, 32) * 2) // 256) % 2 * 16 + T.FloorMod(0, 16)], 2048, 1), T.access_ptr(acc[T.FloorDiv(0, 16) * 4 + T.FloorMod(0, 32) // 8], 4096, 3), 0)
                        T.ptx_arrive_barrier(mbarrier_1[kk % 2 + 2])
                    T.attr(0, "tl.provenance_ordinal", 5)
                    if tx < 256 and tx >= 0:
                        for i in T.unroll(16, annotations={"pragma_unroll_explicit": T.bool(False)}):
                            if by * 64 + offset_local[0] * 64 + (i // 4 * 16 + tx % 128 // 8) < 128 and by * 64 + offset_local[0] * 64 + (i // 4 * 16 + tx % 128 // 8) >= 0:
                                C[by * 64 + offset_local[0] * 64 + i // 4 * 16 + tx % 128 // 8, bx * 64 + tx // 128 * 32 + i % 4 * 8 + tx % 8] = T.Cast("float16", acc[(i // 4 * 16 + tx % 128 // 8) // 16 * 4 + (tx // 128 * 32 + i % 4 * 8 + tx % 8) % 32 // 8])

