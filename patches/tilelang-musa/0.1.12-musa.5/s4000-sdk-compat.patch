diff --git a/maint/scripts/probe_musa_headers.py b/maint/scripts/probe_musa_headers.py
new file mode 100644
index 0000000..05bfc8a
--- /dev/null
+++ b/maint/scripts/probe_musa_headers.py
@@ -0,0 +1,46 @@
+"""Probe the target SDK and generate the optional MUSA template configuration."""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--mcc', default='mcc')
+    parser.add_argument('--arch', required=True)
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    header = '#include <musa_fp8.h>\n#include <musa_fp16.h>\n'
+    options = []
+    with tempfile.TemporaryDirectory() as temp:
+        src = Path(temp) / 'probe.mu'
+        def compile_test(body):
+            src.write_text(header + '__global__ void probe() { ' + body + ' }\n')
+            return subprocess.run([args.mcc, '--cuda-device-only', '--cuda-gpu-arch=' + args.arch,
+                '-std=c++17', '-c', str(src), '-o', str(src.with_suffix('.o'))],
+                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+        control = compile_test('')
+        if control.returncode:
+            raise SystemExit(control.stdout)
+        probes = [
+            ('__mt_fp8_e8m0 value;', 'TILELANG_MUSA_DISABLE_E8M0', '__mt_fp8_e8m0'),
+            ('__half a = __ushort_as_half(0); (void)__hmax_nan(a,a); (void)__hmin_nan(a,a);',
+             'TILELANG_MUSA_PORTABLE_HALF_NAN', '_nan'),
+        ]
+        for body, macro, diagnostic in probes:
+            result = compile_test(body)
+            if result.returncode:
+                if diagnostic not in result.stdout:
+                    raise SystemExit(result.stdout)
+                options.append(macro)
+    config = '#pragma once\n' + ''.join(f'#define {option} 1\n' for option in options)
+    with tempfile.NamedTemporaryFile(mode='w', dir=args.output.parent, delete=False) as f:
+        f.write(config)
+    os.replace(f.name, args.output)
+    print(config, end='')
+
+
+if __name__ == '__main__':
+    main()
