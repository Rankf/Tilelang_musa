diff --git a/src/tl_templates/musa/fop.h b/src/tl_templates/musa/fop.h
index bce7db7..dda757d 100644
--- a/src/tl_templates/musa/fop.h
+++ b/src/tl_templates/musa/fop.h
@@ -32,11 +32,35 @@ TL_DEVICE half_t scalar_min(half_t a, half_t b) {
 }
 
 TL_DEVICE half_t scalar_max_nan(half_t a, half_t b) {
+#if defined(TILELANG_MUSA_PORTABLE_HALF_NAN)
+  if (__hisnan(a.to_half()) || __hisnan(b.to_half())) {
+    return half_t(__ushort_as_half(0x7e00));
+  }
+  const unsigned short lhs = __half_as_ushort(a.to_half());
+  const unsigned short rhs = __half_as_ushort(b.to_half());
+  if (((lhs | rhs) & 0x7fff) == 0) {
+    return half_t(__ushort_as_half(lhs & rhs));
+  }
+  return scalar_max(a, b);
+#else
   return half_t(__hmax_nan(a.to_half(), b.to_half()));
+#endif
 }
 
 TL_DEVICE half_t scalar_min_nan(half_t a, half_t b) {
+#if defined(TILELANG_MUSA_PORTABLE_HALF_NAN)
+  if (__hisnan(a.to_half()) || __hisnan(b.to_half())) {
+    return half_t(__ushort_as_half(0x7e00));
+  }
+  const unsigned short lhs = __half_as_ushort(a.to_half());
+  const unsigned short rhs = __half_as_ushort(b.to_half());
+  if (((lhs | rhs) & 0x7fff) == 0) {
+    return half_t(__ushort_as_half(lhs | rhs));
+  }
+  return scalar_min(a, b);
+#else
   return half_t(__hmin_nan(a.to_half(), b.to_half()));
+#endif
 }
 
 TL_DEVICE bfloat16_t scalar_max(bfloat16_t a, bfloat16_t b) {
